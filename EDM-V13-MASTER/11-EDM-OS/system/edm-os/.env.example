# ---- Database (Supabase Postgres or local docker-compose) ----
DATABASE_URL="postgresql://edm:edm@localhost:5432/edmos?schema=public"

# ---- Supabase (auth + storage) ----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_JWT_SECRET"   # used by the API to verify Supabase access tokens
SUPABASE_STORAGE_BUCKET="edm-os-documents"

# ---- API ----
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- AI providers ----
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# ---- Automation ----
N8N_WEBHOOK_URL="https://YOUR-n8n/webhook/edm-os"

# ---- Microsoft 365 / Graph integration (Outlook calendar sync, mail, OneDrive, SSO) ----
MS_CLIENT_ID="YOUR_AZURE_APP_CLIENT_ID"
MS_CLIENT_SECRET="YOUR_AZURE_APP_CLIENT_SECRET"
MS_TENANT_ID="common"                  # "common" for any work/school account, or your tenant id
MS_REDIRECT_URI="https://YOUR-API/integrations/microsoft/callback"
WEB_BASE_URL="https://YOUR-WEB-APP"    # used to build "Open in EDM OS" links inside calendar events

# ---- Xero integration (won deal -> draft invoice, contact sync) ----
XERO_CLIENT_ID="YOUR_XERO_APP_CLIENT_ID"
XERO_CLIENT_SECRET="YOUR_XERO_APP_CLIENT_SECRET"
XERO_REDIRECT_URI="https://YOUR-API/integrations/xero/callback"

# ---- WhatsApp Business Cloud API (deadline / follow-up alerts) ----
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_PERMANENT_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WABA_ID"

# ---- DocuSign integration (subcontract / transmittal e-signature) ----
DOCUSIGN_CLIENT_ID="YOUR_DOCUSIGN_INTEGRATION_KEY"
DOCUSIGN_CLIENT_SECRET="YOUR_DOCUSIGN_SECRET_KEY"
DOCUSIGN_REDIRECT_URI="https://YOUR-API/integrations/docusign/callback"

# ---- Security (required in production; the API refuses to boot without these) ----
# SUPABASE_JWT_SECRET must NOT be the dev default — set a real secret.
# Generate the encryption key with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_hex_32"
